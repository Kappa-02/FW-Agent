# Optional: enables LLM analysis. Leave blank to explore the offline dashboard.
GOOGLE_API_KEY=

# Override if this model is unavailable for your Google account.
FW_AGENT_MODEL=gemini-2.5-flash

# Default is simulation. Set true only to opt into the local Docker demo.
# A UI confirmation is also required. No firewall rules are applied.
FW_AGENT_ENABLE_DOCKER=false
